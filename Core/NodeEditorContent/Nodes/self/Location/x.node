from PyQt5.QtGui import QColor


class GetSelfLocation(BaseNode):
    # ── Node identity ─────────────────────────────────────────
    # title    = what appears in the node header
    # category = where it shows in the right-click tree
    #            "self/Location" means: folder "self" > subfolder "Location"
    META         = {"title": "Get Self Location", "category": "self/Location"}

    # ── Visual style ──────────────────────────────────────────
    # The color of the header bar (pure red here, pick whatever fits)
    HEADER_COLOR = QColor("#1a3a5c")   # was #ff0000 (red) — changed to blue, up to you
    SUBTITLE     = "Transform"         # small text on the right of the header


    def __init__(self, node_id: str):
        super().__init__(node_id)   # always call this first

        # This node has NO inputs — it just reads the object's own position
        # It has 3 outputs: one per axis
        self.add_out("Location X", "float")
        self.add_out("Location Y", "float")
        self.add_out("Location Z", "float")


    def to_cpp_expr(self, out_pin_index: int, ctx: dict) -> str:
        # out_pin_index tells you WHICH output pin is being asked for
        # 0 = Location X,  1 = Location Y,  2 = Location Z
        #
        # ctx['expr'](node_id, input_pin_index) reads an INPUT pin's value
        # — but this node has no inputs, so we don't call ctx['expr'] at all
        #
        # We just return the C++ expression that matches the requested axis.
        # Your engine must expose something like:
        #     float GetSelfLocationX();
        #     float GetSelfLocationY();
        #     float GetSelfLocationZ();

        if out_pin_index == 0:
            return "GetSelfLocationX()"
        if out_pin_index == 1:
            return "GetSelfLocationY()"
        if out_pin_index == 2:
            return "GetSelfLocationZ()"

        return "0.0f"   # fallback — should never reach here