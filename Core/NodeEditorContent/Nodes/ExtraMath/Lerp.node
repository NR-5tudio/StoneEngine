# Nodes/ExampleMath/Lerp.node
# Linear interpolation: A + (B - A) * Alpha

from PyQt5.QtGui import QColor


class Lerp(BaseNode):
    META         = {"title": "Lerp", "category": "ExampleMath"}
    HEADER_COLOR = QColor("#1e3a2a")
    SUBTITLE     = "Math"

    def __init__(self, node_id: str):
        super().__init__(node_id)
        self.add_in("A",      "float")
        self.add_in("B",      "float")
        self.add_in("Alpha",  "float")
        self.add_out("Result","float")

    def to_cpp_expr(self, out_pin_index: int, ctx: dict) -> str:
        a     = ctx['expr'](self.node_id, 0)
        b     = ctx['expr'](self.node_id, 1)
        alpha = ctx['expr'](self.node_id, 2)
        return f"({a} + ({b} - {a}) * {alpha})"
