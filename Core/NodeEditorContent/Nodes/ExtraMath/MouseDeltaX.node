# Nodes/GameInput/MouseDelta.node
# Outputs mouse movement delta this frame on X or Y axis.
# Engine must expose: float GetMouseDelta(int axis);  // 0=X, 1=Y

from PyQt5.QtGui import QColor


class MouseDeltaX(BaseNode):
    META         = {"title": "Mouse Delta X", "category": "GameInput"}
    HEADER_COLOR = QColor("#3a1a5c")
    SUBTITLE     = "Input"

    def __init__(self, node_id: str):
        super().__init__(node_id)
        self.add_in("Scale",    "float")    # multiply delta by this
        self.add_out("Delta X", "float")

    def to_cpp_expr(self, out_pin_index: int, ctx: dict) -> str:
        scale = ctx['expr'](self.node_id, 0)
        return f"(GetMouseDelta(0) * {scale})"
