# Nodes/ExampleMath/Clamp.node
# Clamps Value between Min and Max.
# C++: std::clamp(value, min, max)   (requires <algorithm>)

from PyQt5.QtGui import QColor


class Clamp(BaseNode):
    META         = {"title": "Clamp", "category": "ExampleMath"}
    HEADER_COLOR = QColor("#1e3a2a")
    SUBTITLE     = "Math"

    def __init__(self, node_id: str):
        super().__init__(node_id)
        self.add_in("Value", "float")
        self.add_in("Min",   "float")
        self.add_in("Max",   "float")
        self.add_out("Result", "float")

    def to_cpp_expr(self, out_pin_index: int, ctx: dict) -> str:
        v   = ctx['expr'](self.node_id, 0)
        mn  = ctx['expr'](self.node_id, 1)
        mx  = ctx['expr'](self.node_id, 2)
        return f"std::clamp({v}, {mn}, {mx})"
